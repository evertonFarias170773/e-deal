# ============================================================
# .env.local.example — ERP Ideal
# Copie para .env.local e preencha com suas chaves reais.
# NUNCA commite .env.local com valores reais.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Maestro AI Gateway ───────────────────────────────────────
# Ativa o LLM real no Maestro (false = usa MockProvider)
MAESTRO_LLM_ENABLED=false

# Chave da OpenAI — NUNCA usar prefixo NEXT_PUBLIC_
# Lida APENAS no servidor (src/app/api/maestro/generate/route.ts)
OPENAI_API_KEY=

# Modelo OpenAI a ser usado (padrão: gpt-4o-mini)
# Opções: gpt-4o-mini | gpt-4o | gpt-3.5-turbo
MAESTRO_OPENAI_MODEL=gpt-4o-mini

# ── Maestro Simple v1 — Humanização por LLM ────────────────────────────────
# Ativa o brain (humanizador LLM) no motor simples.
# false = respostas determinísticas (fallback presenter)
# true  = humaniza com OpenAI após o presenter. Requer OPENAI_API_KEY.
# Flag independente de MAESTRO_LLM_ENABLED (que controla o motor legado).
MAESTRO_SIMPLE_LLM_ENABLED=false

# ── Maestro V2 ────────────────────────────────
# Ativa o motor v2 completo.
MAESTRO_V2_ENABLED=false

# ── Orçamento Avulso (Experimental) ────────────────────────────────
# Ativa especificamente o motor de orçamento avulso no Maestro principal.
# Requer MAESTRO_V2_ENABLED=true
# Default: false (desativado temporariamente para isolamento e testes)
MAESTRO_AVULSO_ENABLED=false

