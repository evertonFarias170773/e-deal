# ============================================================
# .env.local.example — ERP Ideal
# Copie para .env.local e preencha com suas chaves reais.
# NUNCA commite .env.local com valores reais.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── OS em PDF ────────────────────────────────────────────────
# URL canônica do ERP, usada APENAS no servidor (QR Code do PDF da OS).
# NUNCA usar prefixo NEXT_PUBLIC_. Em produção DEVE ser https e sem path;
# se ausente/inválida em produção, o PDF é emitido sem QR Code.
# Ex.: https://erp.ai-ideal.com.br
APP_URL=http://localhost:3000

# ── QR público de produção (OS) ──────────────────────────────
# Liga a página pública /os e o QR do PDF apontando para ela.
# Exige a migration 20260722_os_qr_producao.sql aplicada.
OS_QR_PUBLICO_ENABLED=false
# Segredo HMAC server-only da derivação de tokens (>= 32 bytes hex).
# Trocar o segredo invalida a derivação — rotacione os QRs ativos depois.
OS_QR_TOKEN_SECRET=
# Chave service_role — usada SOMENTE pelo backend (os-qr-token.server.ts)
# para executar os_qr_finalizar. NUNCA usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Maestro AI Gateway ───────────────────────────────────────
# Ativa o LLM real no Maestro (false = usa MockProvider)
MAESTRO_LLM_ENABLED=false

# Chave da OpenAI — NUNCA usar prefixo NEXT_PUBLIC_
# Lida APENAS no servidor (src/app/api/maestro/generate/route.ts)
OPENAI_API_KEY=

# Modelo OpenAI a ser usado (padrão: gpt-4o-mini)
# Opções: gpt-4o-mini | gpt-4o | gpt-3.5-turbo
MAESTRO_OPENAI_MODEL=gpt-4o-mini

# ── Maestro Simple v1 — Humanização por LLM ────────────────────────────────
# Ativa o brain (humanizador LLM) no motor simples.
# false = respostas determinísticas (fallback presenter)
# true  = humaniza com OpenAI após o presenter. Requer OPENAI_API_KEY.
# Flag independente de MAESTRO_LLM_ENABLED (que controla o motor legado).
MAESTRO_SIMPLE_LLM_ENABLED=false

# ── Maestro V2 ────────────────────────────────
# Ativa o motor v2 completo.
MAESTRO_V2_ENABLED=false

# ── Orçamento Avulso (Experimental) ────────────────────────────────
# Ativa especificamente o motor de orçamento avulso no Maestro principal.
# Requer MAESTRO_V2_ENABLED=true
# Default: false (desativado temporariamente para isolamento e testes)
MAESTRO_AVULSO_ENABLED=false

# ── Maestro Agent Loop (v1 — somente leitura) ───────────────────────────────
# Novo motor agêntico: o LLM raciocina e chama múltiplas tools read-only.
# Convive com o motor atual: estado de cotação/escrita ativo permanece no
# legado. Reversão total = MAESTRO_AGENT_LOOP_ENABLED=false.
MAESTRO_AGENT_LOOP_ENABLED=false
# Modelo forte do loop (padrão gpt-4.1). MAESTRO_AGENT_LOOP_MODEL tem
# prioridade sobre MAESTRO_AGENT_MODEL (compartilhado com o POC abaixo).
# MAESTRO_AGENT_LOOP_MODEL=gpt-4.1
# Limites de guarda do loop (padrões: 5 iterações, 8 tool-calls, 25000 ms)
# MAESTRO_AGENT_MAX_ITERATIONS=5
# MAESTRO_AGENT_MAX_TOOL_CALLS=8
# MAESTRO_AGENT_TIMEOUT_MS=25000

# ── Maestro — Persistência de conversa (recomendada para o Agent Loop) ──────
# Requer as migrations 20260722_maestro_conversas.sql (e ..._auditoria.sql)
# APLICADAS. Sem ela, o Agent Loop usa o histórico enviado pelo client.
MAESTRO_PERSISTENCE_ENABLED=false

# ── Maestro Agent Service (POC External Intent) ─────────────────────────────
# Camada experimental de interpretação de intenção via Agent externo.
# false por padrão — não quebra nenhum fluxo se desligada.
MAESTRO_EXTERNAL_INTENT_ENABLED=false
MAESTRO_EXTERNAL_INTENT_URL=
MAESTRO_EXTERNAL_INTENT_SECRET=
MAESTRO_AGENT_PROVIDER=openai
MAESTRO_AGENT_MODEL=gpt-4o-mini
MAESTRO_AGENT_TEMPERATURE=0.2

# ── Cartão de crédito — Asaas (contingência da empresa 1) ───────────────────
# Ambiente Asaas em uso. Valores: SANDBOX | HOMOLOGACAO_LISITON | PRODUCAO_IDEAL
# Só alimenta o log de inicialização e a conferência de coerência da chave —
# nenhum fluxo de cobrança lê esta variável.
#
# ATENÇÃO: a conta Asaas apontada por CHAVE_API_ASAAS hoje é de TERCEIRO
# (LISITON DOCUMENTOS SEGUROS LTDA, CNPJ 41**********00, verificado em
# 01/08/2026). É conta de HOMOLOGAÇÃO. Não emitir cobrança de produção nela:
# o recebimento cai em outro CNPJ e nenhum teste funcional acusa.
#
# HOMOLOGACAO_LISITON NÃO É SANDBOX. A conta e a chave são de PRODUÇÃO
# (prefixo $aact_prod_, host api.asaas.com): qualquer chamada real a
# /v3/payments gera COBRANÇA REAL e cobrável, com dinheiro real, na conta de um
# terceiro. "Homologação" descreve a intenção de uso, não o ambiente técnico.
# Enquanto este for o valor: workflows do n8n desativados, execução só com pin
# data, e o nó Config de cada workflow apontando para api-sandbox.asaas.com.
# Teste sem risco financeiro exige chave de sandbox ($aact_hmlg_), inexistente
# neste ambiente até agora.
# O ponto único de troca pela conta oficial da Ideal está documentado em
# src/features/cobrancas/services/asaas-ambiente.server.ts
ASAAS_AMBIENTE=HOMOLOGACAO_LISITON
# Segunda opção de cartão no modal de cobrança, para quando o checkout C6 falha
# no cliente. O usuário escolhe conscientemente — NÃO existe fallback automático.
# A opção só aparece quando a empresa recebedora já é a 1 (Ideal Gráfica);
# nenhum id_empresa é alterado por trás da tela.
# false por padrão: com a flag desligada o modal fica idêntico ao atual.
# Reversão total = NEXT_PUBLIC_FEATURE_CARTAO_ASAAS=false (ou variável ausente).
NEXT_PUBLIC_FEATURE_CARTAO_ASAAS=false

# Webhook n8n que cria a cobrança CREDIT_CARD no Asaas e devolve o checkout.
# Sem URL configurada a rota /api/cobrancas/gerar-cartao-asaas recusa a chamada
# (nunca há URL hardcoded como fallback). Durante a homologação, aponte para um
# webhook de eco que devolva um invoiceUrl fictício, sem tocar no Asaas.
N8N_ASAAS_CARTAO_URL=
# Webhook n8n que cancela a cobrança de cartão no Asaas. Enquanto não estiver
# configurado, cancelar uma cobrança Asaas retorna erro explícito e NÃO altera
# nada localmente (regra de docs/business/CANCELAMENTO-COBRANCAS.md).
N8N_ASAAS_CANCELAR_URL=
# Segredo compartilhado enviado no header x-erp-webhook-secret nos dois webhooks
# acima. O workflow n8n deve recusar a requisição quando não conferir.
# Server-only: NUNCA usar prefixo NEXT_PUBLIC_. Sem segredo configurado as rotas
# também recusam a chamada.
N8N_ASAAS_CARTAO_SECRET=
